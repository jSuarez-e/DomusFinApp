{
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "scripts": {
    "lint:ts": "eslint \"{frontend,backend,shared}/**/*.ts\" --format json -o docs/audits/eslint-report.json || exit 0",
    "lint:css": "stylelint \"frontend/**/*.css\" --formatter json -o docs/audits/stylelint-report.json || exit 0",
    "audit:all": "npm run lint:ts && npm run lint:css",
    "audit:split": "node scripts/split-audit.mjs",
    "brain:sync": "node scripts/sync-brain.mjs",
    "brain:ask": "node scripts/brain-ask.mjs",
    "brain:run": "node scripts/run-brain.mjs"
  }
}
